# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Include the database name (/vanya) before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vanya?appName=<app>

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# console = print OTPs in the server log (development only). msg91 is not implemented yet.
OTP_PROVIDER=console
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Minutes a customer's selected seats are held while they pay.
HOLD_MINUTES=10

# Payments. mock = fake gateway for development. razorpay needs the three keys.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Extra fee on top of the fare, as a percent of the fare (0 = none).
CONVENIENCE_FEE_PERCENT=0

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
